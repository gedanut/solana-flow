  "narrative": {
    "northStar": "Evidence first",
    "overview": "The implemented workbench expands the restrained report identity into an operational workspace: slate navigation, white working surfaces, teal actions and amber uncertainty. Compact system type and monospace identifiers keep evidence readable without external fonts or assets. This document refreshes the previous dark offline-report description; it records the workbench, not a claim that every report surface uses these values.",
    "keyCharacteristics": [
      "Local system fonts, tabular numerals and exact evidence text.",
      "Flat, bordered working regions rather than decorative dashboard cards.",
      "Explicit scope, uncertainty and status labels alongside color."
