  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
