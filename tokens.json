          "value": 26,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "heading-mobile": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
